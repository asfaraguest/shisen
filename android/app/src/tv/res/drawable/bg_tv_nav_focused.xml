<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused & Selected -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D38BDF8" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Focused only -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3338BDF8" />
            <stroke android:width="2.5dp" android:color="#38BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Selected only (Active page) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2438BDF8" />
            <stroke android:width="1.5dp" android:color="#38BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4038BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default Idle -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
