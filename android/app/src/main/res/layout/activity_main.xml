<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_anime_canvas_shinkai">

    <!-- MAIN APP CONTENT (TOPBAR + FEED) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- DYNAMIC FLUID TOPBAR (54dp Aurora Header) -->
        <FrameLayout
            android:id="@+id/layout_aurora_top"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_aurora_header">

            <!-- Normal State: Branding Logo + Menu Badge + Search Trigger Capsule -->
            <LinearLayout
                android:id="@+id/layout_top_normal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <!-- Logo SHISEN (Glacial Sky Blue) -->
                <TextView
                    android:id="@+id/tv_app_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHISEN"
                    android:textColor="@color/accent_glacial"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />

                <!-- Anime Kanji Brand Touch (Shisen / 視線) -->
                <TextView
                    android:id="@+id/tv_app_logo_kanji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="視線"
                    android:textColor="@color/anime_iris_violet"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold" />

                <!-- Active Menu Category Badge -->
                <TextView
                    android:id="@+id/tv_current_menu_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="今期アニメ"
                    android:textColor="@color/text_frost_bright"
                    android:background="@drawable/bg_badge_frost"
                    android:textSize="9.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Header Loading Spinner -->
                <ProgressBar
                    android:id="@+id/pb_header_loading"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/accent_glacial"
                    android:visibility="gone" />

                <!-- Compact Search Trigger Capsule (Expands on click) -->
                <LinearLayout
                    android:id="@+id/btn_search_trigger"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search_capsule"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/accent_glacial"
                        android:contentDescription="検索" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="検索 • Cari anime..."
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fluid Expanded Search State (Full Width Animated) -->
            <LinearLayout
                android:id="@+id/layout_top_search_fluid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_collapse_search"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_glacial"
                    android:padding="8dp"
                    android:contentDescription="Tutup Pencarian" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_search_capsule"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_frost_subtle"
                        android:contentDescription="Icon Search" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="アニメのタイトルを検索..."
                        android:textColorHint="@color/text_frost_dim"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_frost_subtle"
                        android:visibility="gone"
                        android:contentDescription="Clear Text" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- CONTEXTUAL ACTION BAR (Riwayat / Favorit Counter & Clear Button) -->
        <LinearLayout
            android:id="@+id/layout_contextual_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_contextual_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="視聴履歴 • Riwayat Tontonan"
                android:textColor="@color/text_frost_bright"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/btn_clear_history_all"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_badge_danger"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="全消去 • Hapus Semua"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- SUB-FILTER CAROUSEL (Jadwal 7 Hari / Katalog / Genre) -->
        <HorizontalScrollView
            android:id="@+id/scroll_sub_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layout_sub_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- MAIN ANIME GRID FEED -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 2-Column Responsive Grid View -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anime_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="84dp" />

                <!-- Empty State View -->
                <LinearLayout
                    android:id="@+id/layout_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="作品が見つかりません • Tidak Ada Anime"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="下へスワイプして再読み込み • Tarik untuk memuat ulang"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="@dimen/text_body"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- FULLSCREEN BACKDROP SCRIM FOR FOLDED FLOATING MENU -->
    <View
        android:id="@+id/scrim_folded_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="14dp"
        android:visibility="gone" />

    <!-- FOLDED FLOATING MENU (Unfolds UPWARDS from bottom-right trigger) -->
    <LinearLayout
        android:id="@+id/layout_folded_menu"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="84dp"
        android:orientation="vertical"
        android:gravity="end"
        android:elevation="16dp"
        android:visibility="gone">

        <!-- 1. Musim Ini / Beranda -->
        <LinearLayout
            android:id="@+id/menu_item_musim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_season"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_musim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="今期アニメ • Musim Ini"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 2. Masih Tayang (Airing) -->
        <LinearLayout
            android:id="@+id/menu_item_airing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_airing"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_airing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="放送中 • Sedang Tayang"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 3. Jadwal Rilis 7 Hari WIB -->
        <LinearLayout
            android:id="@+id/menu_item_jadwal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_schedule"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_jadwal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="週間番組表 • Jadwal Rilis"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 4. Riwayat Tontonan -->
        <LinearLayout
            android:id="@+id/menu_item_riwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_history"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_riwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="視聴履歴 • Riwayat Tontonan"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 5. Favorit Saya -->
        <LinearLayout
            android:id="@+id/menu_item_favorit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_favorite"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_favorit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="お気に入り • Favorit Saya"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 6. Katalog Lengkap -->
        <LinearLayout
            android:id="@+id/menu_item_katalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_catalog"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_katalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="作品目録 • Katalog Anime"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 7. Kategori Genre -->
        <LinearLayout
            android:id="@+id/menu_item_genre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_genre"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ジャンル • Kategori Genre"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 8. Pengaturan Terpadu (Settings) -->
        <LinearLayout
            android:id="@+id/menu_item_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_folded_menu_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_menu_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="設定 • Pengaturan Terpadu"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- FLOATING TRANSPARENT PAGINATION BAR (Tatap Official Signature) -->
    <LinearLayout
        android:id="@+id/layout_pagination"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_floating_pagination"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_prev_page"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_page_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="‹ 前へ • Sebelumnya"
            android:textColor="@color/text_frost_bright"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_floating_page_indicator"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="第 1 頁 • Hal 1"
            android:textColor="@color/accent_glacial"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btn_next_page"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_page_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="次へ • Berikutnya ›"
            android:textColor="@color/text_frost_bright"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- FLOATING MENU TRIGGER BUTTON (Bottom-Right FAB) -->
    <FrameLayout
        android:id="@+id/fab_menu_trigger"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_fab_trigger"
        android:elevation="18dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_fab_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu"
            app:tint="@color/accent_glacial"
            android:contentDescription="Menu Folded Trigger" />
    </FrameLayout>
</FrameLayout>
