<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_anime_canvas_shinkai">

    <!-- VIDEO STAGE (ExoPlayer + Scrims + Overlays) -->
    <FrameLayout
        android:id="@+id/fl_player_wrapper"
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:background="#000000">

        <!-- Native Media3 PlayerView -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true"
            app:show_timeout="3500"
            app:show_next_button="true"
            app:show_previous_button="true"
            app:show_subtitle_button="true"
            app:resize_mode="fit"
            app:surface_type="surface_view" />

        <!-- Press and Hold 2X Speed HUD Pill -->
        <LinearLayout
            android:id="@+id/hud_hold_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_player_hud_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_hold_speed_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textColor="@color/accent_glacial"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_hold_speed_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="2X Cepat >>"
                android:textColor="@color/text_frost_bright"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Gesture HUD OSD (Volume, Brightness) -->
        <LinearLayout
            android:id="@+id/hud_osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_player_hud_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="9dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_osd_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOL"
                android:textColor="@color/accent_glacial"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04" />

            <ProgressBar
                android:id="@+id/pb_osd_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="110dp"
                android:layout_height="5dp"
                android:layout_marginStart="12dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_osd_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="50%"
                android:textColor="@color/text_frost_bright"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Double Tap Seek Ripple Indicators -->
        <TextView
            android:id="@+id/tv_ripple_left"
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center"
            android:text="-10s"
            android:textColor="@color/text_frost_bright"
            android:textSize="18sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_ripple_seek_left"
            android:clickable="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_ripple_right"
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:text="+10s"
            android:textColor="@color/text_frost_bright"
            android:textSize="18sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_ripple_seek_right"
            android:clickable="false"
            android:visibility="gone" />

        <!-- Minimalist Buffering & Stream Preparation HUD -->
        <LinearLayout
            android:id="@+id/layout_buffering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_buffering_hud"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pb_video_buffering"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_glacial" />

            <TextView
                android:id="@+id/tv_buffering_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MENYIAPKAN STREAM..."
                android:textColor="@color/accent_glacial"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Custom Subtitle Overlay -->
        <TextView
            android:id="@+id/tv_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="22dp"
            android:layout_marginHorizontal="20dp"
            android:maxWidth="560dp"
            android:elevation="20dp"
            android:clickable="false"
            android:background="@drawable/bg_subtitle_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:gravity="center"
            android:textAlignment="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="3.5"
            android:visibility="gone" />

        <!-- Floating Skip Intro / Outro Button -->
        <Button
            android:id="@+id/btn_skip_op_ed"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="65dp"
            android:backgroundTint="#D9090D16"
            app:strokeColor="@color/accent_glacial"
            app:strokeWidth="1.5dp"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_skip_next"
            app:iconTint="@color/accent_glacial"
            app:iconPadding="5dp"
            app:iconSize="15dp"
            android:paddingHorizontal="14dp"
            android:text="@string/player_skip_op"
            android:textColor="@color/accent_glacial"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.03"
            android:visibility="gone" />

        <!-- Screen Lock Button (Landscape Only) -->
        <ImageButton
            android:id="@+id/btn_screen_lock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_badge_frost"
            android:src="@drawable/ic_lock_open"
            app:tint="@color/text_frost_bright"
            android:visibility="gone"
            android:contentDescription="Kunci Layar" />

        <!-- Floating Safety Unlock Pill (Shown when touching locked screen in Landscape) -->
        <LinearLayout
            android:id="@+id/layout_safety_unlock"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_player_hud_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_glacial" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/player_unlock"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>

        <!-- Top Overlay Header Bar (Minimalist Tatap Scrim) -->
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="20dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_player_top_scrim"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_player_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="@drawable/bg_exo_icon_btn"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_frost_bright"
                android:contentDescription="Kembali" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memuat Video..."
                    android:textColor="@color/text_frost_bright"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_sub_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Subtitle: Auto (Indonesia)"
                    android:textColor="@color/text_frost_subtle"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Legacy Action Buttons (Hidden to keep player header clean like Tatap OG) -->
            <LinearLayout
                android:id="@+id/layout_legacy_top_pills"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_aspect"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_sub_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- WATCH PORTRAIT VIEW BOTTOM PANEL (Professional Tatap Styling) -->
    <LinearLayout
        android:id="@+id/layout_portrait_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/frost_void">

        <!-- Title & Action Bar Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@color/frost_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_portrait_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_frost_bright"
                    android:contentDescription="Kembali" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_portrait_anime_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Judul Anime"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_portrait_current_ep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Memutar Episode 1"
                        android:textColor="@color/accent_glacial"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Action Buttons Row (Evenly distributed, zero-inset capsules) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_portrait_sub"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    android:text="Sub"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_bright"
                    android:backgroundTint="@color/frost_elevated"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/frost_border"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_quality"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    android:text="HD"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_bright"
                    android:backgroundTint="@color/frost_elevated"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/frost_border"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_speed"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    android:text="1.0x"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_bright"
                    android:backgroundTint="@color/frost_elevated"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/frost_border"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_pip"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    android:text="PiP"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_bright"
                    android:backgroundTint="@color/frost_elevated"
                    app:icon="@drawable/ic_pip"
                    app:iconTint="@color/accent_glacial"
                    app:iconSize="12.5dp"
                    app:iconPadding="3dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/frost_border"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_fullscreen"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:gravity="center"
                    android:text="⛶ Full"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent_glacial"
                    android:backgroundTint="#16233B"
                    app:cornerRadius="17dp"
                    app:strokeColor="@color/accent_glacial"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Episode Section Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_portrait_ep_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/player_episodes_title"
                android:textColor="@color/accent_glacial"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.06" />

            <Button
                android:id="@+id/btn_portrait_sort"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="Urutan: 1 - N"
                android:textColor="@color/text_frost_subtle"
                android:backgroundTint="@color/frost_surface"
                app:cornerRadius="14dp"
                app:strokeColor="@color/frost_border"
                app:strokeWidth="1dp"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Grid Episode 4 Kolom -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_portrait_episodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>
</LinearLayout>
