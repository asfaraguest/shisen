<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused Button: Radiant Glass Highlight -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D38BDF8" />
            <stroke android:width="2.2dp" android:color="#38BDF8" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Pressed Button: Glowing Compression -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5238BDF8" />
            <stroke android:width="1.5dp" android:color="#38BDF8" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Idle State: Translucent Frosted Glass Pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F152238" />
            <stroke android:width="1dp" android:color="#283E63" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
