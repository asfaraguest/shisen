<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <!-- Section Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_swimlane_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Judul Bagian"
            android:textColor="@color/text_frost_bright"
            android:textSize="17sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/btn_swimlane_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_see_all"
            android:textColor="@color/accent_glacial"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Horizontal Carousel Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_swimlane_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:overScrollMode="never" />
</LinearLayout>
