<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frost_void">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Aurora Bar & App Branding -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aurora_header"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Logo MENATAP (Glacial Sky Glow) -->
                    <TextView
                        android:id="@+id/tv_app_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MENATAP"
                        android:textColor="@color/accent_glacial"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.08" />

                    <!-- BETA Capsule Badge -->
                    <TextView
                        android:id="@+id/tv_badge_beta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="BETA"
                        android:textColor="@color/accent_glacial"
                        android:background="@drawable/bg_badge_frost"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Header Loading Progress -->
                    <ProgressBar
                        android:id="@+id/pb_header_loading"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/accent_glacial"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Search Box Capsule 36dp -->
                <LinearLayout
                    android:id="@+id/layout_search_box"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_capsule"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_frost_subtle"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Cari anime..."
                        android:textColorHint="@color/text_frost_dim"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_frost_subtle"
                        android:visibility="gone"
                        android:contentDescription="Clear" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 7-Tab Navigation Bar (Horizontal Scrollable Frost Pills) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_nav_musim"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="🌸 Beranda"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="#090D16"
                    android:background="@drawable/bg_chip_frost_active" />

                <TextView
                    android:id="@+id/tab_nav_airing"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="⚡ Sedang Tayang"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/tab_nav_jadwal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="📅 Jadwal Rilis"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/tab_nav_riwayat"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="⌛ Riwayat"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/tab_nav_favorit"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="★ Favorit"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/tab_nav_katalog"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="📚 Katalog"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/tab_nav_genre"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="🎭 Genre"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Dynamic Contextual Sub-Filter Bar (Animates in when Jadwal, Katalog, or Genre is active) -->
        <HorizontalScrollView
            android:id="@+id/scroll_sub_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layout_sub_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Main Feed (SwipeRefreshLayout) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Unified Responsive Anime Grid View -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anime_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="30dp" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layout_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak Ada Anime"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tarik ke bawah untuk memuat ulang"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</FrameLayout>
