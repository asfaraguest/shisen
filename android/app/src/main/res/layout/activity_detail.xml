<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_anime_canvas_shinkai">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layout_detail_scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="50dp">

            <!-- Hero Backdrop with Ambient Gradient Scrim -->
            <FrameLayout
                android:id="@+id/fl_detail_backdrop_container"
                android:layout_width="match_parent"
                android:layout_height="230dp">

                <ImageView
                    android:id="@+id/iv_detail_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ambient Backdrop" />

                <!-- Bottom Fade Scrim -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_gradient_scrim" />

                <!-- Back Button Floating -->
                <ImageButton
                    android:id="@+id/btn_detail_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_badge_frost"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_frost_bright"
                    android:contentDescription="Kembali" />
            </FrameLayout>

            <!-- Anime Info Body (Overlapping Hero Section) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="-75dp">

                <!-- Hero Section: Official Character Cover Card + Primary Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <!-- Official Character Cover Poster Card (Focused on Character) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_detail_poster"
                        android:layout_width="110dp"
                        android:layout_height="160dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/frost_surface"
                        app:strokeColor="@color/anime_border_glow"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:id="@+id/iv_detail_poster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Cover Karakter Anime" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Title & Essential Meta (Side by Side with Poster) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        android:paddingBottom="4dp">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tv_detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Judul Anime"
                            android:textColor="@color/text_frost_bright"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <!-- Alt / Romaji Title + Native Japanese Title -->
                        <TextView
                            android:id="@+id/tv_detail_romaji"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Sousou no Frieren • 葬送のフリーレン"
                            android:textColor="@color/anime_iris_violet"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <!-- Metadata Row (Glacial Sky chips) -->
                        <TextView
                            android:id="@+id/tv_detail_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Spring 2026 · TV · 12 Episode · 8.5 ★"
                            android:textColor="@color/accent_glacial"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <!-- Genres Row -->
                        <TextView
                            android:id="@+id/tv_detail_genres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Fantasi • Petualangan • Sihir"
                            android:textColor="@color/text_frost_subtle"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dual Action Row (Play Primary & Bookmark) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btn_play_primary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/detail_play_ep1"
                        android:textColor="#090D16"
                        android:backgroundTint="@color/accent_glacial"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:cornerRadius="22dp"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_toggle_bookmark"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:text="@string/detail_favorite"
                        android:textColor="@color/text_frost_bright"
                        android:backgroundTint="@color/frost_elevated"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        app:strokeColor="@color/frost_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="22dp"
                        android:paddingHorizontal="16dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- Expandable Synopsis Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/frost_surface"
                    app:strokeColor="@color/frost_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_synopsis_title"
                            android:textColor="@color/accent_glacial"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tv_detail_synopsis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_frost_subtle"
                            android:textSize="12.5sp"
                            android:lineSpacingExtra="3.5dp"
                            android:fontFamily="sans-serif"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:text="@string/detail_loading_synopsis" />

                        <TextView
                            android:id="@+id/tv_synopsis_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/detail_read_more"
                            android:textColor="@color/accent_glacial"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif-bold"
                            android:paddingVertical="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 1: Related Seasons & Series -->
                <LinearLayout
                    android:id="@+id/layout_related_seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_related_seasons_title"
                            android:textColor="@color/accent_glacial"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tv_related_seasons_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_frost_subtle"
                            android:textSize="10.5sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_detail_seasons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Section 2: Related Movies & Films -->
                <LinearLayout
                    android:id="@+id/layout_related_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_related_movies_title"
                            android:textColor="@color/accent_glacial"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tv_related_movies_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_frost_subtle"
                            android:textSize="10.5sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_detail_movies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Episode Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_episode_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_episodes_title"
                        android:textColor="@color/accent_glacial"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.06" />

                    <ProgressBar
                        android:id="@+id/pb_episodes_loading"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminateTint="@color/accent_glacial"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Episode Grid (4 Columns) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_detail_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
