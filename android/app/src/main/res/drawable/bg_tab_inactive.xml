<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1E2B45" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_glacial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/frost_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/frost_border" />
        </shape>
    </item>
</selector>
