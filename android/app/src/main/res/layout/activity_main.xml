<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frost_void">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Aurora Bar & App Branding -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aurora_header"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Logo MENATAP (Glacial Cyan) -->
                    <TextView
                        android:id="@+id/tv_app_logo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MENATAP"
                        android:textColor="@color/accent_glacial"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.08" />

                    <!-- Filter / Refresh Action Button -->
                    <ProgressBar
                        android:id="@+id/pb_header_loading"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/accent_glacial"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Search Box Capsule 36dp -->
                <LinearLayout
                    android:id="@+id/layout_search_box"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_capsule"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_frost_subtle"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Cari anime..."
                        android:textColorHint="@color/text_frost_dim"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_frost_subtle"
                        android:visibility="gone"
                        android:contentDescription="Clear" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Horizontal Filter Chips Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_filter_trending"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Trending"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="#080C14"
                    android:background="@drawable/bg_chip_frost_active" />

                <TextView
                    android:id="@+id/chip_filter_seasonal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Musim Ini"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/chip_filter_popular"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Terpopuler"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/chip_filter_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Film Anime"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />

                <TextView
                    android:id="@+id/chip_filter_otaku"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Sub Indo"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_frost_subtle"
                    android:background="@drawable/bg_chip_frost_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Main Feed Grid -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anime_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="80dp" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layout_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak Ada Anime"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tarik ke bawah untuk memuat ulang"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Floating Frosted Glass Bottom Dock (One-Handed Navigation) -->
    <LinearLayout
        android:id="@+id/floating_bottom_dock"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_dock"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/nav_dock_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ Beranda"
            android:textColor="@color/accent_glacial"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/nav_dock_bookmarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ Favorit"
            android:textColor="@color/text_frost_subtle"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/nav_dock_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌛ Riwayat"
            android:textColor="@color/text_frost_subtle"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp" />
    </LinearLayout>
</FrameLayout>
