<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_frost"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/accent_glacial" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENGATURAN • 設定"
                    android:textColor="@color/text_frost_bright"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Konfigurasi Tema, Safe Mode, Haptic, &amp; AI"
                    android:textColor="@color/text_frost_subtle"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_frost_subtle"
                android:contentDescription="Tutup" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/frost_border" />

        <!-- ================= SECTION 1: TEMA TAMPILAN ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="テーマ設定 • TAMPILAN &amp; TEMA ANIME"
            android:textColor="@color/accent_glacial"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <!-- Theme Shinkai -->
            <LinearLayout
                android:id="@+id/card_theme_shinkai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_frost_inactive"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌌"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新海ブルー • Twilight Shinkai (君の名は)"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deep Cosmic Indigo • Glacial Cyan • Iris Violet"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rb_theme_shinkai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:buttonTint="@color/accent_glacial" />
            </LinearLayout>

            <!-- Theme Sakura -->
            <LinearLayout
                android:id="@+id/card_theme_sakura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_frost_inactive"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌸"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="桜ブロッサム • Sakura Blossom (氷菓)"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Midnight Plum • Blossom Pink • Rose Petal"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rb_theme_sakura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:buttonTint="@color/anime_sakura_pink" />
            </LinearLayout>

            <!-- Theme Cyber -->
            <LinearLayout
                android:id="@+id/card_theme_cyber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_frost_inactive"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="電脳サイバー • Cyber Neo-Tokyo (攻殻機動隊)"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Obsidian Void • Electric Cyan • Cyber Purple"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rb_theme_cyber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:buttonTint="@color/anime_cyan_neon" />
            </LinearLayout>

            <!-- Theme Ghibli -->
            <LinearLayout
                android:id="@+id/card_theme_ghibli"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_frost_inactive"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍃"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ジブリフォレスト • Ghibli Forest (もののけ姫)"
                        android:textColor="@color/text_frost_bright"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deep Forest Teal • Emerald Mint • Star Gold"
                        android:textColor="@color/text_frost_subtle"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rb_theme_ghibli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:buttonTint="@color/anime_mint_miku" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/frost_border" />

        <!-- ================= SECTION 2: SISTEM & KONTEN (SAFE MODE + HAPTIC) ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="安心機能 • KEAMANAN &amp; HAPTIC"
            android:textColor="@color/accent_glacial"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06" />

        <!-- Safe Mode Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_frost_inactive"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Safe Mode Tatap (安心フィルター)"
                    android:textColor="@color/text_frost_bright"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Saring judul anime ecchi &amp; erotica dari katalog dan pencarian. (Genre Hentai selalu diblokir 100%)."
                    android:textColor="@color/text_frost_subtle"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_safe_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/accent_glacial"
                app:trackTint="@color/frost_elevated" />
        </LinearLayout>

        <!-- Haptic Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_frost_inactive"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📳 触覚振動 • Haptic Feedback"
                    android:textColor="@color/text_frost_bright"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Umpan balik taktil halus saat navigasi menu, pagination, dan gesture seek pemutar video."
                    android:textColor="@color/text_frost_subtle"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_haptic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/accent_glacial"
                app:trackTint="@color/frost_elevated" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/frost_border" />

        <!-- ================= SECTION 3: AI SUBTITLE BYOK & MODEL SELECTOR ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI 字幕 • AI SUBTITLE (BYOK)"
                android:textColor="@color/accent_glacial"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tv_settings_ai_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini / Groq / OpenAI / Ollama"
                android:textColor="@color/anime_iris_violet"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- API Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="API Key / Endpoint URL"
            android:textColor="@color/text_frost_bright"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <EditText
            android:id="@+id/et_settings_ai_key"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="AIzaSy... / gsk_... / sk-... / ollama URL"
            android:textColorHint="@color/text_frost_dim"
            android:textColor="@color/text_frost_bright"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Model Selector Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="AIモデル選択 • Model Selector"
            android:textColor="@color/text_frost_bright"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pilih model rekomendasi atau ketikkan nama model kustom:"
            android:textColor="@color/text_frost_subtle"
            android:textSize="10.5sp" />

        <!-- Model Quick Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_model_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Injected programmatically based on detected provider -->
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/et_settings_ai_model"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Nama model (misal: gemini-2.5-flash)"
            android:textColorHint="@color/text_frost_dim"
            android:textColor="@color/accent_glacial"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <!-- Custom Translation Prompt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="字幕生成プロンプト • Prompt Fansub"
                android:textColor="@color/text_frost_bright"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_settings_reset_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="初期化 • Reset"
                android:textColor="@color/accent_glacial"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="2dp"
                android:paddingHorizontal="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_settings_ai_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="5"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Prompt instruksi terjemahan fansub..."
            android:textColorHint="@color/text_frost_dim"
            android:textColor="@color/text_frost_bright"
            android:textSize="12sp"
            android:padding="10dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollbars="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_settings_clear_ai"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_frost_inactive"
                android:text="削除 • Hapus Kunci"
                android:textColor="@color/text_frost_subtle"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_settings_save_ai"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_chip_frost_active"
                android:text="保存 • Simpan AI"
                android:textColor="@color/frost_void"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/frost_border" />

        <!-- ================= SECTION 4: SISTEM & PEMBARUAN ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="システム情報 • SISTEM &amp; PEMBARUAN"
            android:textColor="@color/accent_glacial"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_chip_frost_inactive"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_settings_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shisen 視線 v0.1.0-beta.2"
                android:textColor="@color/text_frost_bright"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⚡ TLS ClientHello Desync DPI-Bypass: Aktif\n🛡️ Multi-Tier DoH DNS: Cloudflare + Google\n📦 Standalone Native Media3 Runtime (0 Server Tertanam)"
                android:textColor="@color/text_frost_subtle"
                android:textSize="10.5sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btn_settings_check_update"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/frost_elevated"
                android:text="🔄 最新版を確認 • Cek Pembaruan"
                android:textColor="@color/text_frost_bright"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="false"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
